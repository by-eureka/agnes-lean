/-
  Nesterov acceleration despite very noisy gradients -- formalization.

  Part 2: the stochastic set-up of Section 3.1 / Appendix D.2.

  We work on a measure space `(Ω, μ)` equipped with a notion of
  *predictability* (`Adapted m z` = `z` is strongly measurable for the
  σ-algebra `m`).  The gradient oracle assumption of Section 3.1 is encoded as

  * `unbiased`:  `∫ ⟪g'_n, z⟫ = ∫ ⟪∇f(x'_n), z⟫` for every predictable test
    vector `z`.  This is the L²-projection form of `E[g'_n | F_n] = ∇f(x'_n)`;
    it is what the tower property and Lemma 14 (3) give in the paper's setting.
  * `var_bound`: `∫ ‖g'_n - ∇f(x'_n)‖² ≤ σ² ∫ ‖∇f(x'_n)‖²`, the integrated
    form of the multiplicative variance bound of Section 3.1.

  **The measure is required to be a probability measure** (`NoiseModel.prob`).
  Section 3.1 fixes a probability space `(Ω, A, P)` and all expectations are
  with respect to it; without this hypothesis the downstream chain is false, as
  `mass_zero_counterexample` records: on a measure of mass zero every integral
  vanishes, and for the constant objective `f ≡ -1` (with `∇f ≡ 0`, which is
  `L`-smooth and convex) the rate of Theorem 3 at `n = 1` reads `1 ≤ 0`.
  Placing the hypothesis here, at the shared model boundary, makes every
  theorem of Parts 3--6 inherit it.

  From these we derive Lemma 15 (3), (4) and Lemma 16.

  **Relation to the paper's sampled oracle.**  Section 3.1 postulates a
  measurable map `g : E × Ω → E` on a probability space `(Ω, A, P)` together
  with *independent* samples `ω_n`, and derives `E[g'_n | F_n] = ∇f(x'_n)` and
  the variance bound from Fubini (Appendix D.2, Lemma 15).  Here the oracle is
  abstract: the *consequences* of that construction are assumed directly, as the
  fields `unbiased` (in projection form: `∫⟪g'_n, z⟫ = ∫⟪∇f(x'_n), z⟫` for every
  `F_n`-predictable test vector `z`) and `var_bound` (integrated multiplicative
  variance).  What is *not* formalized is the probabilistic infrastructure:

  * the product space `Ω̂ = E × ∏_n Ω` with its product σ-algebra and product
    measure, and the filtration `F_n` generated by `x_0, ω_0, …, ω_{n-1}`;
  * the derivation of `unbiased` and `var_bound` from a pointwise oracle `g`
    (Lemma 15 (1), (2)) by Fubini and the tower property;
  * the i.i.d. structure across time, which enters only through predictability.

  Conversely, the two assumed fields are exactly what the tower property and
  Lemma 14 (3) give in the paper's setting, so every estimate proved here
  transfers verbatim to the sampled oracle once those derivations are supplied.
-/
import Proofs.Part1

noncomputable section

open MeasureTheory

namespace AGNES

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {Ω : Type*} [MeasurableSpace Ω]
variable {f : E → ℝ} {grad : E → E}

/-- Predictability: strong measurability with respect to a given σ-algebra. -/
def Adapted (m : MeasurableSpace Ω) (z : Ω → E) : Prop :=
  @MeasureTheory.StronglyMeasurable Ω E _ m z

theorem Adapted.const {m : MeasurableSpace Ω} (v : E) : Adapted m (fun _ => v) :=
  MeasureTheory.stronglyMeasurable_const

theorem Adapted.sub {m : MeasurableSpace Ω} {z z' : Ω → E}
    (h : Adapted m z) (h' : Adapted m z') : Adapted m (z - z') :=
  MeasureTheory.StronglyMeasurable.sub h h'

theorem Adapted.add {m : MeasurableSpace Ω} {z z' : Ω → E}
    (h : Adapted m z) (h' : Adapted m z') : Adapted m (z + z') :=
  MeasureTheory.StronglyMeasurable.add h h'

theorem Adapted.smul {m : MeasurableSpace Ω} {z : Ω → E} (h : Adapted m z) (c : ℝ) :
    Adapted m (c • z) :=
  MeasureTheory.StronglyMeasurable.const_smul h c

/-- The gradient oracle model of Section 3.1 together with the iterates it is
evaluated at. -/
structure NoiseModel (f : E → ℝ) (grad : E → E) where
  mu : Measure Ω
  /-- The underlying probability distribution of Section 3.1.  This is the one
  hypothesis which the whole analysis rests on: see `mass_zero_counterexample`. -/
  prob : IsProbabilityMeasure mu
  sigma : ℝ
  filt : ℕ → MeasurableSpace Ω
  X : ℕ → Ω → E
  X' : ℕ → Ω → E
  G : ℕ → Ω → E
  adapted_X : ∀ n, Adapted (filt n) (X n)
  adapted_X' : ∀ n, Adapted (filt n) (X' n)
  /-- The iterates are random variables (measurable for the ambient σ-algebra). -/
  ae_X : ∀ n, AEStronglyMeasurable (X n) mu
  ae_X' : ∀ n, AEStronglyMeasurable (X' n) mu
  adapted_grad : ∀ n, Adapted (filt n) (fun ω => grad (X' n ω))
  /-- The predictable test vectors used in the Lyapunov argument. -/
  adapted_comb : ∀ n (b a : ℝ) (v : E),
    Adapted (filt n) (fun ω => b • (X' n ω - X n ω) + a • (X' n ω - v))
  /-- Unbiasedness of the gradient oracle (Section 3.1), in projection form. -/
  unbiased : ∀ (n : ℕ) (z : Ω → E), Adapted (filt n) z →
    (∫ ω, inner ℝ (G n ω) (z ω) ∂mu) = ∫ ω, inner ℝ (grad (X' n ω)) (z ω) ∂mu
  /-- Multiplicative variance bound (Section 3.1), integrated. -/
  var_bound : ∀ n, (∫ ω, ‖G n ω - grad (X' n ω)‖ ^ 2 ∂mu) ≤
    sigma ^ 2 * ∫ ω, ‖grad (X' n ω)‖ ^ 2 ∂mu
  ae_G : ∀ n, AEStronglyMeasurable (G n) mu
  ae_grad : ∀ n, AEStronglyMeasurable (fun ω => grad (X' n ω)) mu
  int_G : ∀ n, Integrable (fun ω => ‖G n ω‖ ^ 2) mu
  int_grad : ∀ n, Integrable (fun ω => ‖grad (X' n ω)‖ ^ 2) mu

/-! ### Integrability bookkeeping -/

theorem integrable_inner {μ : Measure Ω} {u v : Ω → E}
    (hu : AEStronglyMeasurable u μ) (hv : AEStronglyMeasurable v μ)
    (hu2 : Integrable (fun ω => ‖u ω‖ ^ 2) μ) (hv2 : Integrable (fun ω => ‖v ω‖ ^ 2) μ) :
    Integrable (fun ω => inner ℝ (u ω) (v ω)) μ := by
  refine Integrable.mono' (g := fun ω => (‖u ω‖ ^ 2 + ‖v ω‖ ^ 2) / 2) ?_ ?_ ?_
  · exact (hu2.add hv2).div_const 2
  · exact hu.inner hv
  · filter_upwards with ω
    rw [Real.norm_eq_abs]
    have h1 : |inner ℝ (u ω) (v ω)| ≤ ‖u ω‖ * ‖v ω‖ := abs_real_inner_le_norm _ _
    have h2 : ‖u ω‖ * ‖v ω‖ ≤ (‖u ω‖ ^ 2 + ‖v ω‖ ^ 2) / 2 := by
      nlinarith [sq_nonneg (‖u ω‖ - ‖v ω‖)]
    linarith

theorem integrable_norm_sq_sub {μ : Measure Ω} {u v : Ω → E}
    (hu : AEStronglyMeasurable u μ) (hv : AEStronglyMeasurable v μ)
    (hu2 : Integrable (fun ω => ‖u ω‖ ^ 2) μ) (hv2 : Integrable (fun ω => ‖v ω‖ ^ 2) μ) :
    Integrable (fun ω => ‖u ω - v ω‖ ^ 2) μ := by
  refine Integrable.mono' (g := fun ω => 2 * ‖u ω‖ ^ 2 + 2 * ‖v ω‖ ^ 2) ?_ ?_ ?_
  · exact ((hu2.const_mul 2).add (hv2.const_mul 2))
  · exact (hu.sub hv).norm.pow 2
  · filter_upwards with ω
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    have h1 : ‖u ω - v ω‖ ≤ ‖u ω‖ + ‖v ω‖ := norm_sub_le _ _
    have h2 : ‖u ω - v ω‖ ^ 2 ≤ (‖u ω‖ + ‖v ω‖) ^ 2 := by
      have h0 : (0 : ℝ) ≤ ‖u ω - v ω‖ := norm_nonneg _
      have h3 : (0 : ℝ) ≤ ‖u ω‖ + ‖v ω‖ := by positivity
      nlinarith [h1]
    nlinarith [h2, sq_nonneg (‖u ω‖ - ‖v ω‖)]

/-! ### Lemma 15 -/

/-- **Lemma 15 (4)**: `E[∇f(x'_n) · g'_n] = E‖∇f(x'_n)‖²`. -/
theorem moment_cross (M : NoiseModel (Ω := Ω) f grad) (n : ℕ) :
    (∫ ω, inner ℝ (M.G n ω) (grad (M.X' n ω)) ∂M.mu)
      = ∫ ω, ‖grad (M.X' n ω)‖ ^ 2 ∂M.mu := by
  rw [M.unbiased n (fun ω => grad (M.X' n ω)) (M.adapted_grad n)]
  exact integral_congr_ae
    (Filter.Eventually.of_forall fun ω => real_inner_self_eq_norm_sq (grad (M.X' n ω)))

/-- **Lemma 15 (3)**: `E‖g'_n‖² ≤ (1+σ²) E‖∇f(x'_n)‖²`. -/
theorem moment_sq (M : NoiseModel (Ω := Ω) f grad) (n : ℕ) :
    (∫ ω, ‖M.G n ω‖ ^ 2 ∂M.mu)
      ≤ (1 + M.sigma ^ 2) * ∫ ω, ‖grad (M.X' n ω)‖ ^ 2 ∂M.mu := by
  have hGw2 : Integrable (fun ω => ‖M.G n ω - grad (M.X' n ω)‖ ^ 2) M.mu :=
    integrable_norm_sq_sub (M.ae_G n) (M.ae_grad n) (M.int_G n) (M.int_grad n)
  have hinner : Integrable (fun ω => inner ℝ (M.G n ω) (grad (M.X' n ω))) M.mu :=
    integrable_inner (M.ae_G n) (M.ae_grad n) (M.int_G n) (M.int_grad n)
  have hpt : ∀ ω, ‖M.G n ω‖ ^ 2 = ‖M.G n ω - grad (M.X' n ω)‖ ^ 2
      + 2 * inner ℝ (M.G n ω) (grad (M.X' n ω)) - ‖grad (M.X' n ω)‖ ^ 2 := by
    intro ω
    have := norm_sub_sq_real (M.G n ω) (grad (M.X' n ω))
    linarith
  have hcalc : (∫ ω, ‖M.G n ω‖ ^ 2 ∂M.mu)
      = (∫ ω, ‖M.G n ω - grad (M.X' n ω)‖ ^ 2 ∂M.mu)
        + 2 * (∫ ω, inner ℝ (M.G n ω) (grad (M.X' n ω)) ∂M.mu)
        - (∫ ω, ‖grad (M.X' n ω)‖ ^ 2 ∂M.mu) := by
    have h1 : (∫ ω, ‖M.G n ω‖ ^ 2 ∂M.mu)
        = ∫ ω, ‖M.G n ω - grad (M.X' n ω)‖ ^ 2
            + 2 * inner ℝ (M.G n ω) (grad (M.X' n ω)) - ‖grad (M.X' n ω)‖ ^ 2
          ∂M.mu :=
      integral_congr_ae (Filter.Eventually.of_forall hpt)
    rw [h1]
    rw [integral_sub, integral_add, integral_const_mul]
    all_goals
      first
      | exact hGw2
      | exact M.int_grad n
      | exact hinner
      | exact hinner.const_mul 2
      | exact hGw2.add (hinner.const_mul 2)
  rw [hcalc, moment_cross M n]
  have hσ := M.var_bound n
  nlinarith [hσ]

/-! ### The AGNES time-stepping scheme (3) and Lemma 16 -/

/-- A run of the AGNES scheme (2)/(3): the iterates `x_n, x'_n` are generated from
the noisy gradients `g'_n` by the time-stepping scheme (2). -/
structure Run (f : E → ℝ) (grad : E → E) where
  base : NoiseModel (Ω := Ω) f grad
  eta : ℝ
  alpha : ℝ
  rho : ℕ → ℝ
  rec1 : ∀ n, base.X (n + 1) =ᵐ[base.mu] fun ω => base.X' n ω - eta • base.G n ω
  rec2 : ∀ n, base.X' (n + 1) =ᵐ[base.mu]
    fun ω => base.X (n + 1) ω + rho n • (base.X' n ω - alpha • base.G n ω - base.X n ω)
  init : base.X 0 =ᵐ[base.mu] base.X' 0
  int_f : ∀ n, Integrable (fun ω => f (base.X n ω)) base.mu
  int_f' : ∀ n, Integrable (fun ω => f (base.X' n ω)) base.mu
  int_sqX : ∀ n, Integrable (fun ω => ‖base.X n ω‖ ^ 2) base.mu
  int_sqX' : ∀ n, Integrable (fun ω => ‖base.X' n ω‖ ^ 2) base.mu

/-- **Lemma 16**: one step of the gradient update decreases the objective in
expectation by `η(1 - L(1+σ²)η/2) E‖∇f(x'_n)‖²`. -/
theorem one_step_decrease (R : Run (Ω := Ω) f grad) (hs : Smooth f grad L)
    (hL : 0 ≤ L) (hη : 0 ≤ R.eta) (n : ℕ)
    (hint : Integrable (fun ω => f (R.base.X' n ω - R.eta • R.base.G n ω)) R.base.mu) :
    (∫ ω, f (R.base.X (n + 1) ω) ∂R.base.mu)
      ≤ (∫ ω, f (R.base.X' n ω) ∂R.base.mu)
        - R.eta * (1 - L * (1 + R.base.sigma ^ 2) * R.eta / 2) *
            (∫ ω, ‖grad (R.base.X' n ω)‖ ^ 2 ∂R.base.mu) := by
  have hmove : (fun ω => f (R.base.X (n + 1) ω))
      =ᵐ[R.base.mu] (fun ω => f (R.base.X' n ω - R.eta • R.base.G n ω)) :=
    (R.rec1 n).fun_comp f
  rw [integral_congr_ae hmove]
  have hpt : ∀ ω, f (R.base.X' n ω - R.eta • R.base.G n ω) ≤
      f (R.base.X' n ω) - R.eta * inner ℝ (R.base.G n ω) (grad (R.base.X' n ω))
        + L * R.eta ^ 2 / 2 * ‖R.base.G n ω‖ ^ 2 := by
    intro ω
    have h := hs (R.base.X' n ω) (R.base.X' n ω - R.eta • R.base.G n ω)
    have hstep : R.base.X' n ω - R.eta • R.base.G n ω - R.base.X' n ω
        = -(R.eta • R.base.G n ω) := by abel
    rw [hstep, inner_neg_right, inner_smul_right, norm_neg, norm_smul_sq] at h
    have hin : inner ℝ (grad (R.base.X' n ω)) (R.base.G n ω)
        = inner ℝ (R.base.G n ω) (grad (R.base.X' n ω)) := real_inner_comm _ _
    rw [hin] at h
    nlinarith [h]
  have hinner : Integrable (fun ω => inner ℝ (R.base.G n ω) (grad (R.base.X' n ω))) R.base.mu :=
    integrable_inner (R.base.ae_G n) (R.base.ae_grad n) (R.base.int_G n) (R.base.int_grad n)
  have hcomb : Integrable (fun ω => f (R.base.X' n ω)
      - R.eta * inner ℝ (R.base.G n ω) (grad (R.base.X' n ω))
      + L * R.eta ^ 2 / 2 * ‖R.base.G n ω‖ ^ 2) R.base.mu :=
    ((R.int_f' n).sub (hinner.const_mul R.eta)).add
      ((R.base.int_G n).const_mul (L * R.eta ^ 2 / 2))
  have hle := integral_mono_ae hint hcomb (Filter.Eventually.of_forall hpt)
  have hsplit : (∫ ω, f (R.base.X' n ω)
      - R.eta * inner ℝ (R.base.G n ω) (grad (R.base.X' n ω))
      + L * R.eta ^ 2 / 2 * ‖R.base.G n ω‖ ^ 2 ∂R.base.mu)
      = (∫ ω, f (R.base.X' n ω) ∂R.base.mu)
        - R.eta * (∫ ω, inner ℝ (R.base.G n ω) (grad (R.base.X' n ω)) ∂R.base.mu)
        + L * R.eta ^ 2 / 2 * (∫ ω, ‖R.base.G n ω‖ ^ 2 ∂R.base.mu) := by
    rw [integral_add, integral_sub, integral_const_mul, integral_const_mul]
    all_goals
      first
      | exact R.int_f' n
      | exact R.base.int_G n
      | exact hinner
      | exact hinner.const_mul R.eta
      | exact (R.base.int_G n).const_mul (L * R.eta ^ 2 / 2)
      | exact (R.int_f' n).sub (hinner.const_mul R.eta)
  rw [hsplit] at hle
  rw [moment_cross R.base n] at hle
  have hσ := moment_sq R.base n
  have hc : (0 : ℝ) ≤ L * R.eta ^ 2 / 2 := by nlinarith
  have hkey : L * R.eta ^ 2 / 2 * (∫ ω, ‖R.base.G n ω‖ ^ 2 ∂R.base.mu)
      ≤ L * R.eta ^ 2 / 2 * ((1 + R.base.sigma ^ 2) *
          ∫ ω, ‖grad (R.base.X' n ω)‖ ^ 2 ∂R.base.mu) :=
    mul_le_mul_of_nonneg_left hσ hc
  linarith [hle, hkey]

/-! ### The counterexample forcing the probability hypothesis -/

/-- Machine-checked record of the counterexample which motivates the field
`NoiseModel.prob`.  Take the constant objective `f ≡ -1` (with zero gradient --
`L`-smooth for every `L > 0` and convex), the zero reference point, and a
measure `μ` of total mass `0`.  Then all expectations vanish, so the estimate
asserted by Theorem 3 at step `n = 1`,
`E[f(x_1) - f(x*)] ≤ a₀² E‖x_0 - x*‖² / (2 α · 1²)`,
reads `1 ≤ 0`.  Every *other* field of the run type is satisfied: the oracle is
unbiased with `σ = 0`, all integrability conditions hold trivially, and both
sides of the recursion may be constant.  Hence the rate cannot be asserted for
an arbitrary (possibly vanishing) measure; the hypothesis is carried by the
model, where every downstream theorem inherits it. -/
theorem mass_zero_counterexample (a0 al : ℝ) :
    ¬ ((∫ _ : Unit, (-1 : ℝ) ∂(0 : Measure Unit)) - (-1 : ℝ)
        ≤ a0 ^ 2 * (∫ _ : Unit, ‖(0 : ℝ) - (0 : ℝ)‖ ^ 2 ∂(0 : Measure Unit))
          / (2 * al * ((1 : ℕ) : ℝ) ^ 2)) := by
  simp

end AGNES
